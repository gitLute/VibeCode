{
  "$schema": "https://opencode.ai/tui.json",

  // Скорость и ускорение прокрутки.
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },

  // "auto" — подстраивать показ диффа под ширину терминала.
  "diff_style": "auto",

  // Поддержка мыши в TUI.
  "mouse": true,

  // Уведомление об окончании ответа агента: баннер в TUI плюс системный звук.
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 1
  }
}
